{
  "$schema": "../../schemas/benchmark-execution-plan.schema.json",
  "protocol_version": "nnrp-1-preview4",
  "suite_version": "python-native-runtime",
  "implementation_name": "nnrp-py",
  "artifacts": {
    "results_path": "artifacts/native-runtime-benchmark-results.json",
    "evidence_dir": "artifacts/native-runtime-benchmark-evidence"
  },
  "scenarios": [
    {
      "id": "l4.runtime.control_metadata.latency",
      "category": "latency",
      "feature": "benchmark.runtime_control.metadata",
      "required_capabilities": [
        "control.cancel_abort",
        "control.deadline_expire",
        "control.progress_partial",
        "control.credit_backpressure",
        "control.result_drop_reason"
      ],
      "description": "Measure preview4 runtime control metadata encode/decode latency across cancellation, deadline, progress, partial-result, pressure, and drop-reason frames.",
      "workload": {
        "operation": "runtime_control_metadata_encode_decode",
        "payload": "control_frame_metadata",
        "iterations": 100000,
        "warmup_iterations": 10000
      }
    },
    {
      "id": "l4.runtime.object_metadata.latency",
      "category": "latency",
      "feature": "benchmark.runtime_object.metadata",
      "required_capabilities": [
        "object.lifecycle",
        "object.delta",
        "cache.reference"
      ],
      "description": "Measure preview4 runtime object and cache metadata encode/decode latency across declare, reference, release, delta, cache-reference, and cache-miss frames.",
      "workload": {
        "operation": "runtime_object_metadata_encode_decode",
        "payload": "object_cache_metadata",
        "iterations": 100000,
        "warmup_iterations": 10000
      }
    },
    {
      "id": "l4.native.submit_result.throughput",
      "category": "throughput",
      "feature": "benchmark.native.submit_result.throughput",
      "required_capabilities": [
        "session.open_close",
        "operation.submit",
        "event.polling.batch"
      ],
      "description": "Measure native runtime submit/result throughput with connection and session setup outside the measured loop.",
      "workload": {
        "operation": "native_submit_result_loop",
        "payload": "inline_payload",
        "payload_bytes": 1024,
        "warmup_iterations": 1000,
        "duration_seconds": 10
      }
    },
    {
      "id": "l4.native.submit_result.cffi_api.throughput",
      "category": "throughput",
      "feature": "benchmark.native.submit_result.cffi_api.throughput",
      "required_capabilities": [
        "session.open_close",
        "operation.submit",
        "event.polling.batch"
      ],
      "description": "Measure native runtime submit/result throughput through an out-of-line cffi API wrapper.",
      "workload": {
        "operation": "native_submit_result_cffi_api_loop",
        "payload": "inline_payload",
        "payload_bytes": 1024,
        "batch_size": 1024,
        "warmup_iterations": 1000,
        "duration_seconds": 10
      }
    },
    {
      "id": "l4.native.submit_cancel.throughput",
      "category": "throughput",
      "feature": "benchmark.native.submit_cancel.throughput",
      "required_capabilities": [
        "session.open_close",
        "operation.submit",
        "control.cancel_abort"
      ],
      "description": "Measure native runtime submit/cancel throughput with connection and session setup outside the measured loop.",
      "workload": {
        "operation": "native_submit_cancel_loop",
        "payload": "inline_payload",
        "payload_bytes": 1024,
        "warmup_iterations": 1000,
        "duration_seconds": 10
      }
    },
    {
      "id": "l4.native.event_polling.throughput",
      "category": "throughput",
      "feature": "benchmark.native.event_polling.throughput",
      "required_capabilities": [
        "event.polling.batch"
      ],
      "description": "Measure native batch event polling throughput with connection setup outside the measured loop.",
      "workload": {
        "operation": "native_batch_event_polling_throughput",
        "payload": "empty_batch",
        "max_events": 8,
        "warmup_iterations": 1000,
        "duration_seconds": 10
      }
    },
    {
      "id": "l4.native.submit_result.profile",
      "category": "memory",
      "feature": "benchmark.native.submit_result.profile",
      "required_capabilities": [
        "session.open_close",
        "operation.submit",
        "event.polling.batch"
      ],
      "description": "Measure native runtime submit/result throughput with CPU and peak traced memory profiling enabled.",
      "workload": {
        "operation": "native_submit_result_loop",
        "payload": "inline_payload",
        "payload_bytes": 1024,
        "warmup_iterations": 1000,
        "duration_seconds": 10,
        "profile": true
      }
    },
    {
      "id": "l4.native.submit_result.cffi_api.profile",
      "category": "memory",
      "feature": "benchmark.native.submit_result.cffi_api.profile",
      "required_capabilities": [
        "session.open_close",
        "operation.submit",
        "event.polling.batch"
      ],
      "description": "Measure native cffi API submit/result throughput with CPU and peak traced memory profiling enabled.",
      "workload": {
        "operation": "native_submit_result_cffi_api_loop",
        "payload": "inline_payload",
        "payload_bytes": 1024,
        "batch_size": 1024,
        "warmup_iterations": 1000,
        "duration_seconds": 10,
        "profile": true
      }
    },
    {
      "id": "l4.native.event_polling.profile",
      "category": "memory",
      "feature": "benchmark.native.event_polling.profile",
      "required_capabilities": [
        "event.polling.batch"
      ],
      "description": "Measure native batch event polling throughput with CPU and peak traced memory profiling enabled.",
      "workload": {
        "operation": "native_batch_event_polling_throughput",
        "payload": "empty_batch",
        "max_events": 8,
        "warmup_iterations": 1000,
        "duration_seconds": 10,
        "profile": true
      }
    }
  ]
}
