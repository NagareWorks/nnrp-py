{
  "$schema": "./native-runtime-smoke-thresholds.schema.json",
  "description": "Post-artifact thresholds for real IPC carrier and adopted client/server role execution. Call-shape gates prevent benchmark-only or synthetic result paths from replacing production ABI 4 boundaries.",
  "thresholds": [
    {
      "id": "l4.native.role_submit_result.throughput",
      "min": {
        "throughput_ops_per_sec": 1,
        "native_ffi_calls_per_op": 4,
        "native_ffi_client_submit_calls_per_op": 1,
        "native_ffi_server_await_events_calls_per_op": 1,
        "native_ffi_server_send_result_calls_per_op": 1,
        "native_ffi_client_await_events_calls_per_op": 1
      },
      "max": {
        "native_ffi_calls_per_op": 4,
        "native_ffi_client_submit_calls_per_op": 1,
        "native_ffi_server_await_events_calls_per_op": 1,
        "native_ffi_server_send_result_calls_per_op": 1,
        "native_ffi_client_await_events_calls_per_op": 1
      }
    },
    {
      "id": "l4.native.submit_cancel.throughput",
      "min": {
        "throughput_ops_per_sec": 1,
        "native_ffi_calls_per_op": 5,
        "native_ffi_client_submit_calls_per_op": 1,
        "native_ffi_client_cancel_calls_per_op": 1,
        "native_ffi_client_await_events_calls_per_op": 1,
        "native_ffi_server_await_events_calls_per_op": 2
      },
      "max": {
        "native_ffi_calls_per_op": 5,
        "native_ffi_client_submit_calls_per_op": 1,
        "native_ffi_client_cancel_calls_per_op": 1,
        "native_ffi_client_await_events_calls_per_op": 1,
        "native_ffi_server_await_events_calls_per_op": 2
      }
    },
    {
      "id": "l4.native.progress_partial.polling.throughput",
      "min": {
        "throughput_ops_per_sec": 1,
        "native_ffi_calls_per_op": 7,
        "native_ffi_client_submit_calls_per_op": 1,
        "native_ffi_server_await_events_calls_per_op": 1,
        "native_ffi_runtime_frame_send_calls_per_op": 2,
        "native_ffi_server_send_result_calls_per_op": 1,
        "native_ffi_client_await_events_calls_per_op": 2
      },
      "max": {
        "native_ffi_calls_per_op": 7,
        "native_ffi_client_submit_calls_per_op": 1,
        "native_ffi_server_await_events_calls_per_op": 1,
        "native_ffi_runtime_frame_send_calls_per_op": 2,
        "native_ffi_server_send_result_calls_per_op": 1,
        "native_ffi_client_await_events_calls_per_op": 2
      }
    },
    {
      "id": "l4.transport.ipc.loopback.throughput",
      "min": {
        "throughput_ops_per_sec": 1,
        "native_ffi_calls_per_op": 4,
        "native_ffi_client_submit_calls_per_op": 1,
        "native_ffi_server_await_events_calls_per_op": 1,
        "native_ffi_server_send_result_calls_per_op": 1,
        "native_ffi_client_await_events_calls_per_op": 1
      },
      "max": {
        "native_ffi_calls_per_op": 4,
        "native_ffi_client_submit_calls_per_op": 1,
        "native_ffi_server_await_events_calls_per_op": 1,
        "native_ffi_server_send_result_calls_per_op": 1,
        "native_ffi_client_await_events_calls_per_op": 1
      }
    },
    {
      "id": "l4.transport.websocket.loopback.throughput",
      "min": {
        "throughput_ops_per_sec": 1,
        "native_ffi_calls_per_op": 4,
        "native_ffi_client_submit_calls_per_op": 1,
        "native_ffi_server_await_events_calls_per_op": 1,
        "native_ffi_server_send_result_calls_per_op": 1,
        "native_ffi_client_await_events_calls_per_op": 1
      },
      "max": {
        "native_ffi_calls_per_op": 4,
        "native_ffi_client_submit_calls_per_op": 1,
        "native_ffi_server_await_events_calls_per_op": 1,
        "native_ffi_server_send_result_calls_per_op": 1,
        "native_ffi_client_await_events_calls_per_op": 1
      }
    },
    {
      "id": "l4.native.event_polling.throughput",
      "min": {
        "throughput_ops_per_sec": 1
      }
    }
  ]
}
