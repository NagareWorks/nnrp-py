{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/NagareWorks/nnrp-py/main/schemas/release-manifest-v1.schema.json",
  "title": "NNRP Python release manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "package", "source", "distributions"],
  "properties": {
    "$schema": {
      "const": "https://raw.githubusercontent.com/NagareWorks/nnrp-py/main/schemas/release-manifest-v1.schema.json"
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "tag"],
      "properties": {
        "name": {"const": "nnrp-py"},
        "version": {"type": "string", "minLength": 1},
        "tag": {"type": "string", "minLength": 1}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commit",
        "rust",
        "conformance_commit",
        "documentation_commit"
      ],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "commit": {"$ref": "#/$defs/commit"},
        "rust": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "source_commit", "release_run_id"],
          "properties": {
            "version": {"type": "string", "minLength": 1},
            "source_commit": {"$ref": "#/$defs/commit"},
            "release_run_id": {"type": "string", "pattern": "^[0-9]+$"}
          }
        },
        "conformance_commit": {"$ref": "#/$defs/commit"},
        "documentation_commit": {"$ref": "#/$defs/commit"}
      }
    },
    "distributions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "size", "sha256"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "size": {"type": "integer", "minimum": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  },
  "$defs": {
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
  }
}
